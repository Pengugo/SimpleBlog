---
const posts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
posts.sort((a: any, b: any) => Date.parse(b.frontmatter.date) - Date.parse(a.frontmatter.date));
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f4ef" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>文章 · 藏书阁</title>
    <style>
      :root { color-scheme: light; --paper: #fff; --ink: #111; --muted: #666; --line: rgba(23, 23, 23, .16); --red: #e5392d; --blue: #1646c8; --font-sans: "Noto Sans SC", "Source Han Sans SC", "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", sans-serif; }
      * { box-sizing: border-box; }
      body { max-width: 1280px; min-height: 100vh; margin: 0 auto; padding: 0 48px 72px; color: var(--ink); background: var(--paper); font-family: var(--font-sans); line-height: 1.8; }
      nav { height: 88px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); font-family: var(--font-sans); font-size: .82rem; font-weight: 600; line-height: 1.4; letter-spacing: .12em; }
      .nav-links { display: flex; align-items: center; gap: 1.5rem; }
      .seal { display: grid; width: 38px; height: 38px; place-items: center; border: 1.5px solid var(--ink); border-radius: 50%; color: var(--ink); font: 800 1.2rem/1 Georgia, serif; }
      nav a { color: var(--ink); text-decoration: none; }
      .nav-links a[aria-current="page"] { color: var(--red); }
      .nav-links a[aria-current="page"]::after { display: block; height: 2px; margin-top: 3px; background: var(--red); content: ""; }
      .theme-toggle { display: grid; width: 38px; height: 38px; place-items: center; border: 1px solid var(--line); border-radius: 50%; background: transparent; color: var(--ink); font: 1.1rem/1 var(--font-sans); cursor: pointer; }
      .theme-toggle:hover, .theme-toggle:focus-visible { border-color: var(--red); color: var(--red); }
      h1 { width: min(100%, 560px); margin: clamp(62px, 10vh, 110px) 0 2rem; font-size: clamp(3rem, 6vw, 5rem); font-weight: 800; letter-spacing: .08em; line-height: .98; }
      ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .9rem; width: min(100%, 900px); list-style: none; margin: 0; padding: 0; }
      li { min-width: 0; }
      .article-card { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: .8rem; min-height: 76px; height: 100%; padding: 1rem 1.1rem; border: 1px solid var(--line); color: var(--ink); text-decoration: none; transition: border-color .18s ease, background .18s ease, transform .18s ease; }
      .article-card:hover, .article-card:focus-visible { border-color: var(--red); background: rgba(229, 57, 45, .045); transform: translateY(-2px); }
      .article-card strong { font-size: .96rem; font-weight: 600; }
      .article-card time { color: var(--muted); font: .68rem/1.4 var(--font-sans); white-space: nowrap; }
      .article-card .arrow { grid-column: 2; grid-row: 1 / span 2; color: var(--red); font-size: 1.1rem; }
      :root[data-theme="dark"] { color-scheme: dark; --paper: #080808; --ink: #f4f4f4; --muted: #aaa; --line: rgba(255,255,255,.2); --red: #ff6259; --blue: #7899ff; }
      @media (prefers-color-scheme: dark) { :root:not([data-theme]) { color-scheme: dark; --paper: #080808; --ink: #f4f4f4; --muted: #aaa; --line: rgba(255,255,255,.2); --red: #ff6259; --blue: #7899ff; } }
      :root[data-theme="dark"] .article-card:hover, :root[data-theme="dark"] .article-card:focus-visible { background: rgba(255, 98, 89, .08); }
      time { color: var(--muted); font: .68rem/1.4 ui-monospace, monospace; white-space: nowrap; }
      @media (max-width: 700px) { body { padding: 0 22px 48px; } nav { height: 72px; } h1 { margin: 8vh 0 2rem; font-size: clamp(3rem, 14vw, 5rem); } ul { grid-template-columns: 1fr; } }
      @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: .01ms !important; } }
    </style>
  </head>
  <body>
    <nav aria-label="主导航">
      <a class="seal" href="/" aria-label="Pengugo 首页">P</a>
      <div class="nav-links"><a href="/">主页</a><a href="/articles/" aria-current="page">文章</a><button class="theme-toggle" type="button" data-theme-toggle aria-label="切换主题" title="切换日间/暗色模式">☾</button></div>
    </nav>
    <main>
      <h1>文章</h1>
      <ul>
        {posts.map((post: any) => (
          <li>
            <a class="article-card" href={post.url}>
              <strong>{post.frontmatter.title}</strong>
              <time datetime={String(post.frontmatter.date).slice(0, 10)}>{String(post.frontmatter.date).slice(0, 10)}</time>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </main>
  </body>
  <script is:inline src="/theme.js"></script>
</html>
