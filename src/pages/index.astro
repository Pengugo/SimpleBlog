---
import PageTransition from '../components/PageTransition.astro';
import IntroSplash from '../components/IntroSplash.astro';
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>焚书阁</title>
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <PageTransition />
    <style>
      :root { color-scheme: light; --paper: #fff; --ink: #111; --muted: #666; --line: rgba(23, 23, 23, .16); --red: #e5392d; --blue: #1646c8; --font-sans: "Noto Sans SC", "Source Han Sans SC", "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", sans-serif; }
      * { box-sizing: border-box; }
      body { max-width: 1280px; min-height: 100vh; margin: 0 auto; padding: 0 48px 72px; font-family: var(--font-sans); line-height: 1.8; color: var(--ink); background-color: var(--paper); overflow-x: hidden; }
      .topbar { height: 88px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); font-family: var(--font-sans); font-size: .82rem; font-weight: 600; line-height: 1.4; letter-spacing: .12em; }
      .nav-left, .nav-right { display: flex; align-items: center; gap: 1.6rem; }
      .seal { display: grid; width: 38px; height: 38px; place-items: center; border: 1.5px solid var(--ink); border-radius: 50%; color: var(--ink); font: 800 1.2rem/1 Georgia, serif; text-decoration: none; }
      .nav-link { position: relative; z-index: 10; display: inline-flex; align-items: center; min-height: 48px; color: var(--ink); text-decoration: none; cursor: pointer; }
      .nav-link:hover, .nav-link[aria-current="page"] { color: var(--red); }
      .nav-link[aria-current="page"]::after { position: absolute; right: 0; bottom: 5px; left: 0; height: 2px; background: var(--red); content: ""; }
      .theme-toggle { display: grid; width: 38px; height: 38px; place-items: center; border: 1px solid var(--line); border-radius: 50%; background: transparent; color: var(--ink); font: 1.1rem/1 var(--font-sans); cursor: pointer; }
      .theme-toggle:hover, .theme-toggle:focus-visible { border-color: var(--red); color: var(--red); }
      .home-layout { position: relative; width: 100%; min-height: calc(100vh - 88px); padding: clamp(62px, 10vh, 110px) 0 90px; }
      .home-title { margin: 0; padding: 0; width: fit-content; white-space: nowrap; }
      h1 { font-size: clamp(5.5rem, 10vw, 9rem); font-weight: 800; letter-spacing: .06em; line-height: .95; }
      .home-note { position: absolute; right: 0; bottom: 24px; max-width: min(100%, 620px); margin: 0; color: var(--ink); font-family: Georgia, "Times New Roman", serif; font-size: clamp(.9rem, 1.05vw, 1rem); font-weight: 400; line-height: 1.7; letter-spacing: .01em; text-align: right; }
      .home-note span { display: block; }
      .home-note span:nth-child(2) { color: var(--muted); }
      :root[data-theme="dark"] { color-scheme: dark; --paper: #080808; --ink: #f4f4f4; --muted: #aaa; --line: rgba(255,255,255,.2); --red: #ff6259; --blue: #7899ff; }
      @media (prefers-color-scheme: dark) { :root:not([data-theme]) { color-scheme: dark; --paper: #080808; --ink: #f4f4f4; --muted: #aaa; --line: rgba(255,255,255,.2); --red: #ff6259; --blue: #7899ff; } }
      @media (max-width: 700px) { body { padding: 0 22px 48px; } .topbar { height: 72px; } .nav-left, .nav-right { gap: 1rem; } .home-layout { min-height: calc(100svh - 72px); padding-top: 8vh; } h1 { font-size: clamp(4.6rem, 18vw, 7rem); } .home-note { bottom: 8px; } }
    </style>
  </head>
  <body>
    <IntroSplash />
    <nav class="topbar" aria-label="主导航">
      <div class="nav-left"><a class="seal" href="/" aria-label="Pengugo 首页">P</a></div>
      <div class="nav-right">
        <a class="nav-link" href="/" aria-current="page">主页</a>
        <a class="nav-link" href="/articles/">文章</a>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换主题" title="切换日间/暗色模式">☾</button>
      </div>
    </nav>
    <main class="home-layout">
      <header>
        <h1 class="home-title">焚书阁</h1>
      </header>
      <p class="home-note">
        <span>What is void phobia?</span>
        <span>The concerns about meaninglessness never become disappeared.</span>
        <span>When there will come up an end?</span>
      </p>
    </main>
  </body>
  <script is:inline src="/theme.js"></script>
</html>
