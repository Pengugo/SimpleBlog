---
const { frontmatter } = Astro.props;
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{frontmatter.title}</title>
    <meta name="theme-color" content="#f7f5f0" />
    <style>
      :root { color-scheme: light; --paper: #f7f5f0; --ink: #292b32; --muted: #777984; --line: #e5e1d8; --accent: #a55743; }
      * { box-sizing: border-box; }
      body { max-width: 760px; min-height: 100vh; margin: 0 auto; padding: 7vh 32px 80px; font-family: "Iowan Old Style", "Noto Serif SC", "Songti SC", Georgia, serif; line-height: 1.85; color: var(--ink); background: var(--paper); }
      nav { margin-bottom: 3.5rem; font: .88rem/1.5 system-ui, sans-serif; }
      nav a { display: inline-flex; align-items: center; gap: .45rem; color: var(--muted); text-decoration: none; transition: color .18s ease; }
      nav a:hover { color: var(--accent); }
      h1 { margin: 0 0 .8rem; font-size: clamp(2rem, 7vw, 3.2rem); font-weight: 500; letter-spacing: .025em; line-height: 1.35; }
      .meta { color: var(--muted); font: .82rem/1.5 system-ui, sans-serif; letter-spacing: .04em; padding-bottom: 1.5rem; border-bottom: 1px solid var(--line); }
      article { margin-top: 2rem; font-size: 1.08rem; }
      article p { margin: 0 0 1.45em; }
      article h2, article h3 { margin: 2.2em 0 .7em; line-height: 1.4; font-weight: 600; }
      article h2 { font-size: 1.55rem; } article h3 { font-size: 1.25rem; }
      article a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: .2em; }
      article blockquote { margin: 1.8rem 0; padding: .2rem 0 .2rem 1.2rem; border-left: 2px solid #c58b78; color: #656773; }
      article hr { border: 0; border-top: 1px solid var(--line); margin: 2.5rem 0; }
      article img { display: block; max-width: 100%; height: auto; margin: 2rem auto; border-radius: 3px; }
      article pre { overflow-x: auto; padding: 1rem 1.2rem; border: 1px solid var(--line); border-radius: 6px; background: #f0ede6; font-size: .9rem; }
      article code { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .88em; }
      @media (max-width: 520px) { body { padding: 5vh 22px 56px; } nav { margin-bottom: 2.7rem; } article { font-size: 1.02rem; } }
      @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: .01ms !important; } }
    </style>
  </head>
  <body>
    <nav><a href="/">← 返回主页</a></nav>
    <main>
      <h1>{frontmatter.title}</h1>
      <div class="meta">{String(frontmatter.date).slice(0, 10)}</div>
      <article>
        <slot />
      </article>
    </main>
  </body>
</html>
