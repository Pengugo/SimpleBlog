---
import PageTransition from '../components/PageTransition.astro';
import Footer from '../components/Footer.astro';

const { frontmatter } = Astro.props;
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{frontmatter.title}</title>
    <meta name="theme-color" content="#f5f4ef" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <PageTransition />
    <style>
      :root { color-scheme: light; --paper: #fff; --ink: #111; --muted: #666; --line: rgba(23, 23, 23, .16); --red: #e5392d; --blue: #1646c8; --panel: #f0ede6; --font-sans: "Noto Sans SC", "Source Han Sans SC", "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", sans-serif; }
      * { box-sizing: border-box; }
      body { max-width: 1280px; min-height: 100vh; margin: 0 auto; padding: 0 48px 80px; font-family: var(--font-sans); line-height: 1.85; color: var(--ink); background-color: var(--paper); }
      nav { height: 88px; margin-bottom: clamp(62px, 10vh, 110px); display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); font-family: var(--font-sans); font-size: .82rem; font-weight: 600; line-height: 1.4; letter-spacing: .12em; }
      .seal { display: grid; width: 38px; height: 38px; place-items: center; border: 1.5px solid var(--ink); border-radius: 50%; color: var(--ink); font: 800 1.2rem/1 Georgia, serif; text-decoration: none; }
      .nav-links { display: flex; align-items: center; gap: 1.6rem; }
      .theme-toggle { display: grid; width: 38px; height: 38px; place-items: center; border: 1px solid var(--line); border-radius: 50%; background: transparent; color: var(--ink); font: 1.1rem/1 var(--font-sans); cursor: pointer; }
      .theme-toggle:hover, .theme-toggle:focus-visible { border-color: var(--red); color: var(--red); }
      nav a { color: var(--ink); text-decoration: none; transition: color .18s ease; }
      nav a:hover, nav a[aria-current="page"] { color: var(--red); }
      nav a[aria-current="page"]::after { display: block; height: 2px; margin-top: 3px; background: var(--red); content: ""; }
      main { width: min(100%, 700px); }
      h1 { max-width: 700px; margin: 0 0 .8rem; font-size: clamp(2.5rem, 6vw, 4.8rem); font-weight: 800; letter-spacing: .04em; line-height: 1.15; }
      .meta { color: var(--muted); font: .82rem/1.5 system-ui, sans-serif; letter-spacing: .04em; padding-bottom: 1.5rem; border-bottom: 1px solid var(--line); }
      article { margin-top: 2rem; font-size: 1.08rem; }
      article p { margin: 0 0 1.45em; }
      article h2, article h3 { margin: 2.2em 0 .7em; line-height: 1.4; font-weight: 600; }
      article h2 { font-size: 1.55rem; } article h3 { font-size: 1.25rem; }
      article a { color: var(--blue); text-decoration-thickness: 1px; text-underline-offset: .2em; }
      article blockquote { margin: 1.8rem 0; padding: .2rem 0 .2rem 1.2rem; border-left: 2px solid var(--red); color: var(--muted); }
      article hr { border: 0; border-top: 1px solid var(--line); margin: 2.5rem 0; }
      article img { display: block; max-width: 100%; height: auto; margin: 2rem auto; border-radius: 3px; }
      article pre { overflow-x: auto; padding: 1rem 1.2rem; border: 1px solid var(--line); border-radius: 6px; background: var(--panel); font-size: .9rem; }
      article code { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .88em; }
      .return-wrap { margin-top: 4rem; padding-top: 1.2rem; border-top: 1px solid var(--line); }
      .return-link { display: inline-flex; align-items: center; gap: .7rem; color: var(--ink); font: 600 .75rem/1.4 var(--font-sans); letter-spacing: .08em; text-decoration: none; transition: color .2s ease, gap .2s ease; }
      .return-link:hover { color: var(--red); gap: 1rem; }
      .return-arrow { display: inline-grid; width: 2rem; height: 2rem; place-items: center; border: 1px solid currentColor; border-radius: 50%; transition: transform .2s ease; }
      .return-link:hover .return-arrow { transform: translateX(-3px); }
      :root[data-theme="dark"] { color-scheme: dark; --paper: #080808; --ink: #f4f4f4; --muted: #aaa; --line: rgba(255,255,255,.2); --red: #ff6259; --blue: #7899ff; --panel: #171717; }
      @media (prefers-color-scheme: dark) { :root:not([data-theme]) { color-scheme: dark; --paper: #080808; --ink: #f4f4f4; --muted: #aaa; --line: rgba(255,255,255,.2); --red: #ff6259; --blue: #7899ff; --panel: #171717; } }
      @media (max-width: 600px) { body { padding: 0 22px 56px; } nav { height: 72px; margin-bottom: 8vh; } .nav-links { gap: 1rem; } article { font-size: 1.02rem; } }
      @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: .01ms !important; } }
    </style>
  </head>
  <body>
    <nav aria-label="主导航">
      <a class="seal" href="/" aria-label="Pengugo 首页">P</a>
      <div class="nav-links"><a href="/">主页</a><a href="/articles/" aria-current="page">文章</a><button class="theme-toggle" type="button" data-theme-toggle aria-label="切换主题" title="切换日间/暗色模式">☾</button></div>
    </nav>
    <main>
      <h1>{frontmatter.title}</h1>
      <div class="meta">{String(frontmatter.date).slice(0, 10)}</div>
      <article>
        <slot />
      </article>
      <div class="return-wrap">
        <a class="return-link" href="/articles/"><span class="return-arrow" aria-hidden="true">←</span>返回文章目录</a>
      </div>
    </main>
    <Footer />
  </body>
  <script is:inline src="/theme.js"></script>
</html>
